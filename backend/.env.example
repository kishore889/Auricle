# AURICLE Backend Environment Variables

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AURICLE Backend"
APP_ENV="development"
API_PREFIX="/api"

# CORS (Frontend Dev URL — comma-separate multiple origins if needed)
FRONTEND_ORIGIN="http://localhost:5173"

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://auricle:auricle_password@localhost:5432/auricle_db"

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="CHANGE-ME-TO-A-SECURE-RANDOM-SECRET-AT-LEAST-32-CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/  (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID="185957975454-lks6238p81k373a35c3hphet1hk6q8d4.apps.googleusercontent.com"
